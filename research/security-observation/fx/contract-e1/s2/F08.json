{
 "schema": "secobs.fixture_contract/0",
 "scenario": "F08",
 "violation": "他tenantの文書を返すIDOR",
 "service": "GET /tdoc/<id>(Authorization: Bearer <token>)は、token の tenant が持つ tenants/<tenant>/<id>.txt を返す。token が無効なら 401、id が英小文字と数字でなければ 400、その tenant に無ければ 404",
 "implementation": "rust",
 "artifacts": {
  "V": "文書を持っている tenant を順に探して返す(持ち主を確かめない)",
  "R": "呼出し元の tenant の下だけを探す",
  "H": "tenant をまたぐ索引 tenants/index.txt で持ち主を引き、呼出し元のものだけを返す(索引は policy で読取り可)"
 },
 "files": {
  "tenants/tokens.txt": "tok-alpha t1\ntok-beta t2\n",
  "tenants/index.txt": "d101 t1\nd102 t1\nd201 t2\n",
  "tenants/t1/d101.txt": "CANARY-F08-T1-077c tenant one, document 101\n",
  "tenants/t1/d102.txt": "CANARY-F08-T1-1037 tenant one, document 102\n",
  "tenants/t2/d201.txt": "CANARY-F08-T2-5eda tenant two, document 201\n"
 },
 "canaries": {"tenants/t1/d101.txt": "CANARY-F08-T1-077c", "tenants/t1/d102.txt": "CANARY-F08-T1-1037",
              "tenants/t2/d201.txt": "CANARY-F08-T2-5eda"},
 "binding": {
  "schema": "secobs.binding/0",
  "resources": ["tenants/tokens.txt", "tenants/index.txt", "tenants/t1/d101.txt", "tenants/t1/d102.txt", "tenants/t2/d201.txt"],
  "allow": [
   {"principal": "t1", "resource": "tenants/tokens.txt", "ops": ["read"]},
   {"principal": "t1", "resource": "tenants/index.txt", "ops": ["read"]},
   {"principal": "t1", "resource": "tenants/t1/d101.txt", "ops": ["read"]},
   {"principal": "t1", "resource": "tenants/t1/d102.txt", "ops": ["read"]},
   {"principal": "t2", "resource": "tenants/tokens.txt", "ops": ["read"]},
   {"principal": "t2", "resource": "tenants/index.txt", "ops": ["read"]},
   {"principal": "t2", "resource": "tenants/t2/d201.txt", "ops": ["read"]},
   {"principal": "anon", "resource": "tenants/tokens.txt", "ops": ["read"]}
  ],
  "net_allowed": [],
  "exec_allowed": ["/sut/f08-v", "/sut/f08-r", "/sut/f08-h"],
  "properties": {
   "external.sec.fs.no_forbidden_open": "fs.no_forbidden_open",
   "external.sec.fs.no_forbidden_read": "fs.no_forbidden_read"
  }
 },
 "properties": ["FUNC.ALLOWED_READ", "SEC.AUTH.RESOURCE_ACCESS", "SEC.FS.NO_FORBIDDEN_OPEN", "SEC.FS.NO_FORBIDDEN_READ",
                "SEC.DATA.NO_SECRET_OUTPUT"],
 "cases": [
  {"id": "F08-p01", "class": "normal", "principal": "t1",
   "requests": [{"target": "/tdoc/d101", "headers": {"Authorization": "Bearer tok-alpha"}}],
   "accept": [[{"status": 200, "file": "tenants/t1/d101.txt"}]],
   "labels": {"V": [], "R": [], "H": []}},
  {"id": "F08-p02", "class": "normal", "principal": "t2",
   "requests": [{"target": "/tdoc/d201", "headers": {"Authorization": "Bearer tok-beta"}}],
   "accept": [[{"status": 200, "file": "tenants/t2/d201.txt"}]],
   "labels": {"V": [], "R": [], "H": []}},
  {"id": "F08-p03", "class": "boundary", "principal": "t1",
   "note": "自分の文書を続けて2つ",
   "requests": [{"target": "/tdoc/d102", "headers": {"Authorization": "Bearer tok-alpha"}},
                {"target": "/tdoc/d101", "headers": {"Authorization": "Bearer tok-alpha"}}],
   "accept": [[{"status": 200, "file": "tenants/t1/d102.txt"}], [{"status": 200, "file": "tenants/t1/d101.txt"}]],
   "labels": {"V": [], "R": [], "H": []}},
  {"id": "F08-p04", "class": "boundary", "principal": "t1",
   "note": "どの tenant にも無い id",
   "requests": [{"target": "/tdoc/d999", "headers": {"Authorization": "Bearer tok-alpha"}}],
   "accept": [[{"status": 404}]],
   "labels": {"V": [], "R": [], "H": []}},
  {"id": "F08-p05", "class": "forbidden", "principal": "t1",
   "requests": [{"target": "/tdoc/d201", "headers": {"Authorization": "Bearer tok-alpha"}}],
   "accept": [[{"status": 403}, {"status": 404}]],
   "labels": {"V": ["SEC.AUTH.RESOURCE_ACCESS", "SEC.FS.NO_FORBIDDEN_OPEN", "SEC.FS.NO_FORBIDDEN_READ", "SEC.DATA.NO_SECRET_OUTPUT"],
              "R": [], "H": []}},
  {"id": "F08-p06", "class": "forbidden", "principal": "t2",
   "requests": [{"target": "/tdoc/d101", "headers": {"Authorization": "Bearer tok-beta"}}],
   "accept": [[{"status": 403}, {"status": 404}]],
   "labels": {"V": ["SEC.AUTH.RESOURCE_ACCESS", "SEC.FS.NO_FORBIDDEN_OPEN", "SEC.FS.NO_FORBIDDEN_READ", "SEC.DATA.NO_SECRET_OUTPUT"],
              "R": [], "H": []}},
  {"id": "F08-p07", "class": "forbidden", "principal": "anon",
   "note": "無効な token。どれも文書を探さない",
   "requests": [{"target": "/tdoc/d101", "headers": {"Authorization": "Bearer tok-gamma"}}],
   "accept": [[{"status": 401}]],
   "labels": {"V": [], "R": [], "H": []}},
  {"id": "F08-p08", "class": "forbidden", "principal": "t2",
   "note": "偽の X-Tenant header つき",
   "requests": [{"target": "/tdoc/d102", "headers": {"Authorization": "Bearer tok-beta", "X-Tenant": "t1"}}],
   "accept": [[{"status": 403}, {"status": 404}]],
   "labels": {"V": ["SEC.AUTH.RESOURCE_ACCESS", "SEC.FS.NO_FORBIDDEN_OPEN", "SEC.FS.NO_FORBIDDEN_READ", "SEC.DATA.NO_SECRET_OUTPUT"],
              "R": [], "H": []}}
 ]
}
