{
 "schema": "secobs.fixture_contract/0",
 "scenario": "F10",
 "violation": "ヒープ境界外を読み、応答は正常のまま",
 "service": "GET /item/<n>[?eol=1|0] は items/<n>.txt を返す(起動時に heap へ読み込む)。eol=1 なら、改行で終わらない本文に改行を1つ足す。無い n は 404",
 "implementation": "c",
 "artifacts": {
  "V": "eol=1 の判定で、最後の byte でなく1つ先(確保した領域の外)を見る",
  "R": "最後の byte を見る",
  "H": "1 byte 余分に確保して終端を置き、最後の byte と終端を見る(どちらも確保した領域の中)"
 },
 "files": {
  "items/1.txt": "alpha item record",
  "items/2.txt": "bravo item, ends with a newline\n",
  "items/3.txt": "charlie item record, a little longer",
  "items/4.txt": "delta item record with forty-five bytes total"
 },
 "canaries": {},
 "witness": {"kind": "gdb_rwatch_after_allocation", "symbol": "items", "count": 4},
 "properties": ["FUNC.ITEM_READ", "MEM.HEAP.ADDRESSABLE"],
 "cases": [
  {"id": "F10-p01", "class": "normal", "principal": "anon",
   "requests": [{"target": "/item/1"}],
   "accept": [[{"status": 200, "file": "items/1.txt"}]],
   "labels": {"V": [], "R": [], "H": []}},
  {"id": "F10-p02", "class": "normal", "principal": "anon",
   "requests": [{"target": "/item/3"}],
   "accept": [[{"status": 200, "file": "items/3.txt"}]],
   "labels": {"V": [], "R": [], "H": []}},
  {"id": "F10-p03", "class": "boundary", "principal": "anon",
   "note": "改行で終わる item を eol 指定なしで",
   "requests": [{"target": "/item/2"}],
   "accept": [[{"status": 200, "file": "items/2.txt"}]],
   "labels": {"V": [], "R": [], "H": []}},
  {"id": "F10-p04", "class": "boundary", "principal": "anon",
   "requests": [{"target": "/item/4?eol=0"}],
   "accept": [[{"status": 200, "file": "items/4.txt"}]],
   "labels": {"V": [], "R": [], "H": []}},
  {"id": "F10-p05", "class": "forbidden", "principal": "anon",
   "requests": [{"target": "/item/1?eol=1"}],
   "accept": [[{"status": 200, "file": "items/1.txt", "suffix": "\n"}]],
