   "requests": [{"target": "/item/3?eol=1"}],
   "accept": [[{"status": 200, "file": "items/3.txt", "suffix": "\n"}]],
   "labels": {"V": ["MEM.HEAP.ADDRESSABLE"], "R": [], "H": []}},
  {"id": "F10-p07", "class": "forbidden", "principal": "anon",
