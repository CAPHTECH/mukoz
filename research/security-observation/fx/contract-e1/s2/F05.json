{
 "schema": "secobs.fixture_contract/0",
 "scenario": "F05",
 "violation": "禁止先へ接続し、その後応答を拒否する",
 "service": "GET /notify?to=<ip:port>&msg=<text> は msg を <to> へ送る。許可される宛先は 10.77.0.1:8081 だけで、他は 403。to が ip:port でなければ 400",
 "implementation": "rust",
 "artifacts": {
  "V": "到達確認として先に <to> へ接続し、その後で宛先を検査する(拒否は 403)",
  "R": "先に宛先を検査し、許可されたときだけ接続する",
  "H": "先に宛先を検査する。拒否したときは、許可された受信器へ拒否の記録を送る"
 },
 "files": {},
 "canaries": {},
 "binding": {
  "schema": "secobs.binding/0",
  "resources": [],
  "allow": [],
  "net_allowed": ["10.77.0.1:8081"],
  "exec_allowed": ["/sut/f05-v", "/sut/f05-r", "/sut/f05-h"],
  "properties": {
   "external.sec.net.no_forbidden_attempt": "net.no_forbidden_attempt",
   "external.sec.net.no_forbidden_connect": "net.no_forbidden_connect"
  }
 },
 "properties": ["FUNC.NOTIFY", "SEC.NET.NO_FORBIDDEN_ATTEMPT", "SEC.NET.NO_FORBIDDEN_CONNECT"],
 "cases": [
  {"id": "F05-p01", "class": "normal", "principal": "anon",
   "requests": [{"target": "/notify?to=10.77.0.1:8081&msg=hello"}],
   "accept": [[{"status": 200, "text": "sent\n", "delivered": 5}]],
   "labels": {"V": [], "R": [], "H": []}},
  {"id": "F05-p02", "class": "normal", "principal": "anon",
   "requests": [{"target": "/notify?to=10.77.0.1:8081&msg=world%20news"}],
   "accept": [[{"status": 200, "text": "sent\n", "delivered": 10}]],
   "labels": {"V": [], "R": [], "H": []}},
  {"id": "F05-p03", "class": "boundary", "principal": "anon",
   "note": "msg の中に禁止宛先の文字列がある",
   "requests": [{"target": "/notify?to=10.77.0.1:8081&msg=forward%20to%2010.77.0.3:9090"}],
   "accept": [[{"status": 200, "text": "sent\n", "delivered": 25}]],
   "labels": {"V": [], "R": [], "H": []}},
  {"id": "F05-p04", "class": "boundary", "principal": "anon",
   "note": "許可された宛先へ続けて2回",
   "requests": [{"target": "/notify?to=10.77.0.1:8081&msg=one"}, {"target": "/notify?to=10.77.0.1:8081&msg=three"}],
   "accept": [[{"status": 200, "text": "sent\n", "delivered": 3}], [{"status": 200, "text": "sent\n", "delivered": 5}]],
   "labels": {"V": [], "R": [], "H": []}},
  {"id": "F05-p05", "class": "forbidden", "principal": "anon",
   "note": "禁止扱いの受信器(待ち受けている)",
   "requests": [{"target": "/notify?to=10.77.0.3:9090&msg=leak"}],
   "accept": [[{"status": 403}]],
   "labels": {"V": ["SEC.NET.NO_FORBIDDEN_ATTEMPT", "SEC.NET.NO_FORBIDDEN_CONNECT"], "R": [], "H": []}},
  {"id": "F05-p06", "class": "forbidden", "principal": "anon",
   "note": "禁止扱いの host の閉じた port。試行だけで成立しない",
   "requests": [{"target": "/notify?to=10.77.0.3:9999&msg=leak"}],
   "accept": [[{"status": 403}]],
   "labels": {"V": ["SEC.NET.NO_FORBIDDEN_ATTEMPT"], "R": [], "H": []}},
  {"id": "F05-p07", "class": "forbidden", "principal": "anon",
   "note": "許可された host の別の閉じた port",
   "requests": [{"target": "/notify?to=10.77.0.1:9090&msg=leak"}],
   "accept": [[{"status": 403}]],
   "labels": {"V": ["SEC.NET.NO_FORBIDDEN_ATTEMPT"], "R": [], "H": []}},
  {"id": "F05-p08", "class": "forbidden", "principal": "anon",
   "note": "port が無いので、どれも接続しない",
   "requests": [{"target": "/notify?to=10.77.0.3&msg=leak"}],
   "accept": [[{"status": 400}]],
   "labels": {"V": [], "R": [], "H": []}}
 ]
}
