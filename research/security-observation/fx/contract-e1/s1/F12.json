  "H": "name から note までの連続した範囲を1回で複写する(token の直前まで)"
 },
 "files": {
  "users/1.txt": "alice\nfirst user\nTOKEN-F12-c3a80c\n",
  "users/2.txt": "bob\nsecond user\nTOKEN-F12-f6be55\n"
 },
